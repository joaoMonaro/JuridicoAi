{
  "uid": "juridicoai-assistente",
  "title": "JuridicoAI — Assistente / Operação",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "juridicoai",
    "p04"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API disponível",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "juridicoai-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "probe_success{job=\"juridicoai-api\"}",
          "refId": "A",
          "legendFormat": "{{category}} {{dimension}} {{outcome}} {{stage}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Idade da última coleta",
      "type": "stat",
