      "name": "00 - Infraestrutura",
      "item": [
        {
          "name": "Verificação básica",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "url": "{{baseUrl}}/",
            "description": "Retorna Hello World!. Não é um health check das dependências."
          },
          "response": []
