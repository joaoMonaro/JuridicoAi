# Identifica e isola os recursos deste Docker Compose.
COMPOSE_PROJECT_NAME=juridicoai

# Banco e credenciais locais do PostgreSQL.
POSTGRES_DB=juridicoai
POSTGRES_USER=juridico
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
Auth__JwtSecret=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Assistente de IA. Mantenha desabilitado até configurar modelo e chave via
# variável de ambiente ou user-secrets; nunca versionar uma chave real.
AssistenteIa__Enabled=false
AssistenteIa__Provider=OpenAI
AssistenteIa__Model=
AssistenteIa__ApiKey=
AssistenteIa__MaxRequestBodyBytes=524288
AssistenteIa__MaxInputTokens=60000
AssistenteIa__RequestsPerUserPerMinute=10
AssistenteIa__ConcurrentRequestsPerUser=2
AssistenteIa__RequestsPerOrganizationPerMinute=30
AssistenteIa__ConcurrentRequestsPerOrganization=6
# Limite mensal inicial configurado para o piloto (US$ 5,00 por organização/mês UTC)
# e tarifas do modelo configurado (sem tarifas presumidas; informe valores reais antes de habilitar IA).
AssistenteIa__DefaultMonthlyLimitUsd=5.00
AssistenteIa__InputCostPerMillionTokensUsd=0
AssistenteIa__CachedInputCostPerMillionTokensUsd=0
AssistenteIa__OutputCostPerMillionTokensUsd=0
AssistenteIa__PricingVersion=unconfigured
