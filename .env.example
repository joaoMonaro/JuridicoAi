# Identifica e isola os recursos deste Docker Compose.
COMPOSE_PROJECT_NAME=juridicoai

# Credenciais locais do MongoDB.
MONGO_ROOT_USERNAME=juridico
MONGO_ROOT_PASSWORD=troque-esta-senha

# Banco e credenciais locais do PostgreSQL.
POSTGRES_DB=juridicoai
POSTGRES_USER=juridico
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
Auth__JwtSecret=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Assistente de IA. Mantenha desabilitado até configurar modelo e chave via
# variável de ambiente ou user-secrets; nunca versionar uma chave real.
AssistenteIa__Enabled=false
AssistenteIa__Provider=OpenAI
AssistenteIa__Model=
AssistenteIa__ApiKey=
