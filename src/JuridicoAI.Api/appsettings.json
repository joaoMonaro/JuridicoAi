{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Mongo": {
    "ConnectionString": "",
    "DatabaseName": "JuridicoAi",
    "RawCollectionName": "jurisprudencias_raw",
    "JurisprudenciasCollectionName": "jurisprudencias",
    "ServerSelectionTimeoutSeconds": 10
  },
  "Postgres": {
    "ConnectionString": "",
    "RunMigrations": true
  },
  "Auth": {
    "JwtSecret": "",
    "Issuer": "JuridicoAI",
    "Audience": "JuridicoAI.Web",
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlDays": 30,
    "SecureRefreshCookie": false
  },
  "DocumentStorage": {
    "RootPath": "data/documentos",
    "MaxFileSizeBytes": 20971520,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".txt", ".png", ".jpg", ".jpeg" ],
    "AllowedMimeTypes": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "text/plain",
      "image/png",
      "image/jpeg"
    ]
  },
  "PecaExport": {
    "LibreOfficePath": "soffice",
    "TimeoutSeconds": 60,
    "MaxConcurrentConversions": 2
  },
  "AssistenteDocumentos": {
    "Enabled": false,
    "OcrEnabled": false,
    "OcrCalibrationVersion": ""
  },
  "AssistenteIa": {
    "ReviewV2Enabled": false,
    "ConversationV2Enabled": false,
    "AutomaticConversationEnabled": false,
    "Enabled": false,
    "Provider": "OpenAI",
    "Model": "",
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "TimeoutSeconds": 90,
    "MaxInstructionCharacters": 4000,
    "MaxDocumentContextCharacters": 60000,
    "MaxAdditionalContextCharacters": 8000,
    "MaxTotalContextCharacters": 80000,
    "MaxInputTokens": 60000,
    "MaxOutputCharacters": 20000,
    "MaxOutputTokens": 6000,
    "MaxRequestBodyBytes": 524288,
    "RequestsPerUserPerMinute": 10,
    "ConcurrentRequestsPerUser": 2,
    "RequestsPerOrganizationPerMinute": 30,
    "ConcurrentRequestsPerOrganization": 6,
    "InputCostPerMillionTokensUsd": 0,
    "CachedInputCostPerMillionTokensUsd": 0,
    "OutputCostPerMillionTokensUsd": 0,
    "PricingVersion": "unconfigured",
    "TransparencyNoticeVersion": "ai-transparency-v1",
    "PrivacyPolicyUrl": null
  },
  "Scraper": {
    "TimeoutSeconds": 120,
    "MaxResults": 30
  },
  "AllowedHosts": "*"
}
