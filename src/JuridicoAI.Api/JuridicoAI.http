@JuridicoAI.Api_HostAddress = http://localhost:5299
@accessToken = substitua-pelo-access-token
@casoId = 00000000-0000-0000-0000-000000000000
@envolvidoId = 00000000-0000-0000-0000-000000000000
@pecaId = 00000000-0000-0000-0000-000000000000

GET {{JuridicoAI.Api_HostAddress}}/
Accept: application/json

###

POST {{JuridicoAI.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "organizationName": "Escritório Exemplo",
  "name": "João da Silva",
  "email": "joao@example.com",
  "password": "senha-segura-com-12-ou-mais"
}

###

POST {{JuridicoAI.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "joao@example.com",
  "senha": "senha-segura-com-12-ou-mais"
}

###

POST {{JuridicoAI.Api_HostAddress}}/auth/refresh

###

GET {{JuridicoAI.Api_HostAddress}}/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{JuridicoAI.Api_HostAddress}}/casos/{{casoId}}/envolvidos
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "nome": "João da Silva",
  "tipo": "Cliente",
  "natureza": "PessoaFisica",
  "cpfCnpj": "529.982.247-25",
  "email": "joao@example.com"
}

###

POST {{JuridicoAI.Api_HostAddress}}/casos/{{casoId}}/envolvidos/{{envolvidoId}}/enderecos
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "tipo": "Residencial",
  "principal": true,
  "cep": "01001-000",
  "logradouro": "Praça da Sé",
  "numero": "100-A",
  "bairro": "Sé",
  "cidade": "São Paulo",
  "uf": "SP",
  "pais": "BR"
}

###

POST {{JuridicoAI.Api_HostAddress}}/api/jurisprudencias/ingest
Content-Type: application/json

{
  "termo": "negativação indevida dano moral",
  "maxResultados": 30
}

###

GET {{JuridicoAI.Api_HostAddress}}/api/jurisprudencias?tema=negativacao_indevida&danoMoral=true&resultado=provavelmente_favoravel_consumidor

###

GET {{JuridicoAI.Api_HostAddress}}/api/jurisprudencias/raw?limite=20

###

POST {{JuridicoAI.Api_HostAddress}}/api/jurisprudencias/reprocess?limite=500

###

GET {{JuridicoAI.Api_HostAddress}}/assistente/capacidades
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{JuridicoAI.Api_HostAddress}}/pecas/{{pecaId}}/assistente/solicitacoes
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: text/event-stream

{
  "clientRequestId": "11111111-1111-1111-1111-111111111111",
  "modo": "Perguntar",
  "instrucao": "Quais pontos desta fundamentação precisam ser esclarecidos?",
  "versaoPeca": 1,
  "operacaoPreferida": "ResponderNoPainel",
  "contexto": {
    "documento": {
      "escopo": "SecaoAtual",
      "texto": "DA FUNDAMENTAÇÃO\nA parte autora sofreu bloqueio indevido de sua conta.",
      "tituloSecao": "DA FUNDAMENTAÇÃO",
      "selecao": null,
      "cursor": null,
      "revisaoEditor": 1
    },
    "contextoAdicional": null,
    "incluirDadosCaso": false,
    "contextoCasoIds": []
  }
}
